# ── Veritas environment ────────────────────────────────────────────────
# Copy to .env.local for local development. All three values come from
# your Supabase project: Dashboard → Project Settings → API.

# Public — safe to expose to the browser (RLS protects all reads/writes).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose to the browser, never commit.
# Used solely for: dashboard-stats refresh, contradiction scans, seeding.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site URL — used for sitemap, robots, OG tags, auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AI research agents (Post-1.0 Phase B) — server-side only ──────────────────
# The model provider is chosen ENTIRELY by env, so cloud↔local is config-only.
# DEFAULT = local Ollama via the OpenAI-compatible API → ZERO per-call cost.
# The cloud adapters exist but are OFF unless you change VERITAS_LLM_PROVIDER,
# so nothing can ever bill you unless you explicitly opt in.

# openai-compatible (DEFAULT, local Ollama) | anthropic | openai
# VERITAS_LLM_PROVIDER=openai-compatible
# VERITAS_LLM_BASE_URL=http://localhost:11434/v1   # local Ollama (default)
# VERITAS_LLM_MODEL=qwen2.5:14b                     # default for openai-compatible
# VERITAS_LLM_API_KEY=                              # blank for Ollama; REQUIRED for cloud

# Per-run caps (also overridable with --flags on the runner).
# AGENT_MAX_MODEL_CALLS=8
# AGENT_MAX_PROPOSALS=5
# AGENT_MAX_OUTPUT_TOKENS=50000

# Scoped bearer token for an agent runner — mint with scripts/mint-agent-token.mjs.
# Never the service-role key; accepted only on POST /api/agent/suggestions.
# VERITAS_AGENT_TOKEN=veagt_…

# ── Citation verifier (Post-1.0 Phase D stage 2) — server-side only ───────────
# OPTIONAL. A contact address added to the User-Agent that lib/citations.ts sends
# to Crossref, which puts the request in Crossref's "polite pool" — identified
# callers get more reliable service and rate limits than anonymous ones.
# Unset is fine: the mailto is simply omitted from the User-Agent and citation
# verification still works, just anonymously. Nothing fails without it.
# VERITAS_CROSSREF_MAILTO=you@example.com
